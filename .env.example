# Copy to .env for Docker Compose, or paste into Dokploy's Environment panel.
# Optional display address only; IP and reverse proxy access work without it.
# You can also set the display address in Yingku's Settings page.
YINGKU_PUBLIC_URL=
YINGKU_HOST_PORT=8787
YINGKU_BIND_IP=0.0.0.0

# Host directories. In Dokploy, ../files stays outside the redeployed checkout.
# Use absolute server paths for existing NAS media, e.g. /mnt/storage/videos.
YINGKU_CONFIG_PATH=../files/yingku/config
YINGKU_MEDIA_PATH=../files/yingku/media

# Container directories. Normally leave these as supplied.
YINGKU_DATA_DIR=/config
YINGKU_MEDIA_DIR=/media
TZ=Asia/Shanghai

# Optional. Existing saved Baidu application configuration can also be reused.
YINGKU_BAIDU_CLIENT_ID=
YINGKU_BAIDU_CLIENT_SECRET=
